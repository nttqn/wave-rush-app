# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Platform folders are generated by CI (flutter create) so the repo
# doesn't need Flutter/Android SDK installed locally.
/android/
/ios/
/macos/
/linux/
/windows/
/web/

# Release signing — never commit these.
*.jks
*.keystore
key.properties

# iOS signing — never commit these either (private key, cert, and the
# provisioning profile are all sensitive/credential material).
*.key
*.p12
*.cer
*.certSigningRequest
*.mobileprovision

.flutter-plugins
.metadata
pubspec.lock

# Owner-supplied source audio; the copies actually used live in assets/audio/.
sound_src/
keystore-base64.txt
*.p8
*-base64.txt

# Promo videos are large binaries; rebuild with tool/promo/ instead of committing them.
store/promo/*.mp4
